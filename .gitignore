# Ignorar archivos de configuración de entorno
.clang-format
.clangd

# Ignorar archivos personalizados
*.mk
*.project
Makefile
*.workspace
*.json
*.DS_Store
*.cache*
*.codelite
*Debug*

# Ignorar binarios compilados
*.o
*.out
*.exe
*.elf
*.dSYM/

# Archivos de backup/temporales
*~
*.swp

# Binarios de capítulos (ignora ejecutables, conserva fuentes)
ch*/[!.]*
!ch*/*.c
!ch*/*.h
!ch*/Makefile
